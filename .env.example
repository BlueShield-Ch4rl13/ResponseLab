# Configuracion del motor. Copia este fichero a .env y rellenalo.
# .env esta en .gitignore: los secretos nunca van al repositorio.
#
# Genera cada token con:  python -m responselab token
# (da el token, que se entrega una vez, y su huella SHA-256, que va al perfil)

# --- Motor -------------------------------------------------------------------
# Token de administracion (/metricas, recargar, auditoria global)
RL_ADMIN_TOKEN=
# URL con la que los avisos enlazan al panel
RL_URL_PUBLICA=https://localhost:8443
# Interruptor de emergencia: "true" pone a TODOS los clientes en simulacion,
# diga lo que diga su perfil. Empieza siempre asi.
RL_SIMULACION_GLOBAL=true
RL_TRABAJADORES=4
RL_LOG_NIVEL=INFO

# Actualizacion automatica del catalogo desde el repositorio. El motor la
# descarga, la valida y solo la usa si pasa (si no, sigue con la anterior).
# Vacio = usar solo el catalogo de la imagen.
RL_ACTUALIZACION_URL=https://raw.githubusercontent.com/BlueShield-Ch4rl13/ResponseLab/main/catalogo/catalogo.json
RL_ACTUALIZACION_MIN=30

# Inteligencia de News CTI (ScriptNewsCTI)
RL_CTI_URL=https://raw.githubusercontent.com/BlueShield-Ch4rl13/ScriptNewsCTI/main/data/iocs_latest.json
RL_CTI_MIN=60
RL_CTI_NIVEL_MINIMO=media
RL_CTI_MAX_DIAS=30

# --- Proxy TLS (docker-compose.yml) -----------------------------------------
RL_DOMINIO=localhost
# "internal" = CA propia de Caddy (laboratorio). En produccion, un correo para
# Let's Encrypt o monta tus certificados en el Caddyfile.
RL_TLS=internal

# --- Cliente lab (Infra-SocAnalyst) ------------------------------------------
# En el laboratorio los tokens van en variables; en un cliente real el perfil
# guarda solo su huella (token_sha256).
RL_LAB_TOKEN=
RL_LAB_TOKEN_AGENTES=
RL_LAB_TOKEN_EDL=
RL_LAB_TOKEN_APROBADOR=
RL_LAB_WAZUH_USUARIO=
RL_LAB_WAZUH_CLAVE=
RL_LAB_THEHIVE_KEY=
RL_LAB_DISCORD_WEBHOOK=

# --- Cliente acme (ejemplo: Microsoft, Palo Alto, Cloudflare, Kubernetes) ----
RL_ACME_MS_CLIENT_ID=
RL_ACME_MS_CLIENT_SECRET=
RL_ACME_PANOS_KEY=
RL_ACME_CLOUDFLARE_TOKEN=
RL_ACME_K8S_TOKEN=
RL_ACME_SPLUNK_TOKEN=
RL_ACME_THEHIVE_KEY=
RL_ACME_SNOW_URL=
RL_ACME_SNOW_USUARIO=
RL_ACME_SNOW_CLAVE=
RL_ACME_TEAMS_WEBHOOK=
RL_ACME_SMTP_USUARIO=
RL_ACME_SMTP_CLAVE=

# --- Cliente norte (ejemplo industrial: CrowdStrike, FortiGate) --------------
RL_NORTE_FALCON_CLIENT_ID=
RL_NORTE_FALCON_CLIENT_SECRET=
RL_NORTE_FORTIGATE_TOKEN=
RL_NORTE_THEHIVE_KEY=
RL_NORTE_SLACK_WEBHOOK=
